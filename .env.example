# Server configuration
PORT=3000
NODE_ENV=development

# Signs portal session tokens. Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Required in production. Set strong unique values in your hosting provider
# secret manager; do not reuse the local demo credentials.
# ADMIN_EMAIL=admin@your-domain.example
# ADMIN_PASSCODE=replace-with-a-long-random-secret
# TECH_PASSCODE=replace-with-a-different-long-random-secret

# Durable state on serverless hosts (Upstash Redis / Vercel KV REST credentials).
# Without these the app keeps state in memory per instance and reseeds on cold starts.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional integrations / hosting metadata
# GEMINI_API_KEY=
APP_URL=http://localhost:3000
